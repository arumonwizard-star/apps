{
  "name": "alien-lab",
  "productName": "Alien Lab",
  "version": "1.0.0",
  "description": "Alien Lab",
  "main": "main.js",
  "author": "Yuito Nomura",
  "license": "UNLICENSED",
  "devDependencies": {
    "electron": "45.5.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "jp.yuito.alienlab",
    "productName": "Alien Lab",
    "copyright": "Yuito Nomura",
    "files": [
      "main.js",
      "preload.js",
      "remote.js",
      "ui/**"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "mac": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.entertainment",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSCameraUsageDescription": "Live Camera",
        "NSMicrophoneUsageDescription": "Mic",
        "LSMinimumSystemVersion": "12.0",
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Alien Lab Project",
            "CFBundleTypeRole": "Editor",
            "LSHandlerRank": "Owner",
            "CFBundleTypeIconFile": "alienlab.icns",
            "LSItemContentTypes": [
              "jp.yuito.alienlab.project"
            ]
          }
        ],
        "UTExportedTypeDeclarations": [
          {
            "UTTypeIdentifier": "jp.yuito.alienlab.project",
            "UTTypeDescription": "Alien Lab Project",
            "UTTypeConformsTo": [
              "public.json",
              "public.data"
            ],
            "UTTypeIconFile": "alienlab.icns",
            "UTTypeTagSpecification": {
              "public.filename-extension": [
                "alienlab"
              ],
              "public.mime-type": [
                "application/x-alienlab"
              ]
            }
          }
        ]
      },
      "extraResources": [
        {
          "from": "build/alienlab.icns",
          "to": "alienlab.icns"
        }
      ]
    }
  }
}
